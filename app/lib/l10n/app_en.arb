  "instructionButton": "GUIDE",
  "instructionTitle": "How it works",
  "instructionHubManifest": "No exercise catalog and no ready-made programs. You name movements in your own words — the app keeps stats on them.",
  "instructionSearchHint": "Search the guide",
  "instructionSearchEmpty": "Nothing found.",
  "instructionChapterStartTitle": "Getting started",
  "instructionChapterStartBlurb": "Home screen, the two modes, and how the app thinks.",
  "instructionChapterSessionTitle": "During a workout",
  "instructionChapterSessionBlurb": "Sets, weight, reps, RIR, an exercise note, cardio, and finishing a session.",
  "instructionChapterTimerTitle": "Stopwatch",
  "instructionChapterTimerBlurb": "Intervals, rest between sets, and cues.",
  "instructionChapterExercisesTitle": "Exercises and groups",
  "instructionChapterExercisesBlurb": "Your movement list, muscle groups, favorites, and the quick workout.",
  "instructionChapterProgressTitle": "Progress and records",
  "instructionChapterProgressBlurb": "Personal progress, 1RM, tonnage, and the exercise chart.",
  "instructionChapterRhythmTitle": "Rhythm and recovery",
  "instructionChapterRhythmBlurb": "The weekly rhythm gauge, muscle load, and the deload week.",
  "instructionChapterDataTitle": "History and data",
  "instructionChapterDataBlurb": "Calendar, editing records, statistics, and backup.",
  "instructionChapterCoachTitle": "Coach mode",
  "instructionChapterCoachBlurb": "Clients, schedule, session plan, and print.",
  "instructionPhilosophy": "IronVibe does not teach you how to train and does not hand you ready-made programs — that is what a coach and your own experience are for. There is no catalog of thousands of exercises: you type movement names in your own words, and the app quietly does the counting. Everything stays on the device: no accounts, no subscriptions, no ads.",
  "instructionSectionHome": "Home",
  "instructionThemeTitle": "Theme",
  "instructionThemeDesc": "The sun–moon switch changes light and dark. Your choice is remembered.",
  "instructionTrainSelfTitle": "I train myself",
  "instructionTrainSelfDesc": "Your space: workouts, calendar, personal progress, favorites, the rhythm gauge, and muscle load.",
  "instructionTrainOthersTitle": "I train others",
  "instructionTrainOthersDesc": "Coach mode: clients, a schedule, and a separate history for each person. It never mixes with your own training.",
  "instructionLanguageTitle": "Language",
  "instructionLanguageDesc": "The app follows the system language — there is no separate setting. Twelve languages are supported.",
  "instructionHomeLinksTitle": "Version and contact",
  "instructionHomeLinksDesc": "At the bottom of the home screen: version number, website, Telegram, support email, and the privacy policy.",
  "instructionSectionAthleteMenu": "Your training",
  "instructionStartWorkoutTitle": "Start workout",
  "instructionStartWorkoutDesc": "Opens an empty session — the last workout is not copied. Add exercises, log sets, then finish to save.",
  "instructionQuickWorkoutTitle": "Quick workout",
  "instructionQuickWorkoutDesc": "Builds a full-body session from four exercises using your muscle-group tags.",
  "instructionCalendarMenuTitle": "Workout calendar",
  "instructionCalendarMenuDesc": "The days you trained. Open saved sessions here, or add one you missed.",
  "instructionSectionPersonalProgress": "Personal progress",
  "instructionPersonalProgressMenuDesc": "A table of best sets, estimated 1RM, and max volume for every movement.",
  "instructionFavoritesMenuTitle": "Favorite exercises",
  "instructionFavoritesMenuDesc": "Movements marked with a star. Build a workout from them in a couple of taps.",
  "instructionSectionWorkout": "Session",
  "instructionStrengthCardioTitle": "Strength or cardio",
  "instructionStrengthCardioDesc": "The switch at the top of the session sets the workout type. Strength: weight, reps, and RIR. Cardio: time and intensity. If the other type is already logged, the app asks before switching.",
  "instructionAddExerciseTitle": "Add exercise",
  "instructionAddExerciseBody": "A new block is added once the current exercise has a name and at least one completed set.",
  "instructionPreviousHintsTitle": "Grey hints",
  "instructionPreviousHintsDesc": "Last time's weight and reps show in grey — a target to beat, not a logged set. Only numbers you type yourself go into history.",
  "instructionExerciseNoteTitle": "Exercise note",
  "instructionExerciseNoteDesc": "The pencil on the exercise header is a note for this workout only. Older notes for the same movement are listed above, each with its date. Clear the field to remove the note. It stays with that session, including in a saved workout.",
  "instructionRemoveExerciseTitle": "Remove exercise",
  "instructionRemoveExerciseDesc": "The red X removes the block from the current session. Saved history is not changed.",
  "instructionReorderExercisesTitle": "Change exercise order",
  "instructionReorderExercisesDesc": "Tap the drag handle on the exercise header. A short list opens: drag a row into place. The new order is saved for this workout and stays that way in its history.",
  "instructionSectionSetControl": "Set row",
  "instructionSetPlusLabel": "Plus",
  "instructionSetPlusDesc": "Adds an empty row for the next set.",
  "instructionSetMinusLabel": "Minus",
  "instructionSetMinusDesc": "Removes the last set. An empty row is deleted at once; a filled one after confirmation. If only one set remains, the fields are simply cleared.",
  "instructionSetProgressLabel": "Exercise chart",
  "instructionSetProgressDesc": "Opens the trend for this movement over a month, a year, or all time.",
  "instructionExerciseVolumeTitle": "Exercise tonnage",
  "instructionExerciseVolumeDesc": "To the right of the chart button: the sum of weight × reps across every completed set. Updates as you type.",
  "instructionSectionInputs": "What the fields mean",
  "instructionWeightTitle": "Weight",
  "instructionWeightBody": "Working load on the bar or machine. Enter kilograms or pounds — the app does not convert units and does not force a choice.",
  "instructionRepsTitle": "Reps",
  "instructionRepsBody": "How many repetitions you did in the set.",
  "instructionRirTitle": "RIR — reps in reserve",
  "instructionRirBody": "How many more reps you could have done. 0 is work to failure, ∞ is a warm-up set. A simple way to dose intensity.",
  "instructionOneRmTitle": "1RM — one-rep max",
  "instructionOneRmDesc": "An estimated max for a single repetition, using the Epley formula from that set's weight and reps. Shown under the row — a key strength landmark.",
  "instructionSectionCardio": "Cardio",
  "instructionCardioTitle": "Time",
  "instructionCardioBody": "Block duration in minutes. No distance and no heart rate: the app is not tied to trackers.",
  "instructionIntensityTitle": "Intensity",
  "instructionIntensityBody": "Effort from 1 to 5 — a simplified RPE scale. In a cardio session, one row is saved per exercise.",
  "instructionSectionSaving": "Finishing",
  "instructionFinishTitle": "Finish workout",
  "instructionFinishBody": "The button at the bottom of the session: the app confirms, then writes the workout to history. You need at least one completed set.",
  "instructionLeaveWorkoutTitle": "Leaving early",
  "instructionLeaveWorkoutDesc": "If you close a session that already has data, you can stay, save what you logged, or delete the draft.",
  "instructionAutoSaveTitle": "Interrupted workout",
  "instructionAutoSaveDesc": "A draft is saved on its own — every minute and when you background the app. Next launch, you can continue from the same place or delete it.",
  "instructionScreenAwakeTitle": "Screen stays on",
  "instructionScreenAwakeDesc": "During a live session the screen stays awake, so you do not unlock the phone after every set.",
  "instructionStopwatchWhyTitle": "Why time rest",
  "instructionStopwatchWhyBody": "The pause between sets is a working parameter, same as weight and reps: short rest raises density, long rest lets you hit a heavy set.",
  "instructionStopwatchHowTitle": "Start, pause, reset",
  "instructionStopwatchHowBody": "The timer is pinned in the session header and stays visible as you scroll. Time and controls sit in the center; in normal mode it counts up, including hundredths of a second.",
  "instructionStopwatchIntervalsTitle": "Left: intervals",
  "instructionStopwatchIntervalsBody": "1/1 — a minute of work and a minute of rest. 4/4 — four minutes each. 20/10 — Tabata. Phases loop until you pause or reset: red tint is work, blue is rest.",
  "instructionStopwatchRestTitle": "Right: rest",
  "instructionStopwatchRestBody": "+1m, +2m, and +5m start a countdown between sets. If a countdown is already running, minutes are added to the remaining time; an interval loop switches to rest.",
  "instructionStopwatchProgressTitle": "Phase bar",
  "instructionStopwatchProgressBody": "In countdown and interval modes, a bar under the digits shows how much of the current phase is left.",
  "instructionStopwatchSoundsTitle": "Sound and haptics",
  "instructionStopwatchSoundsBody": "Three, two, and one seconds before a phase ends — a short click and a light vibration; the phase change is louder. Sounds are built into the app: no microphone, no notification permission. Volume follows the phone settings.",
  "instructionExerciseBankIntro": "The exercise list grows on its own: every new name from a finished workout joins the suggestions. Names are stored in uppercase so the same movement never splits in two.",
  "instructionSectionExerciseNameTools": "Names",
  "instructionRenameExerciseTitle": "Rename everywhere",
  "instructionRenameExerciseDesc": "Long-press the name — in a session, in the suggestion list, or in a saved workout. It updates across history and on the charts.",
  "instructionRemoveFromBankTitle": "Remove from suggestions",
  "instructionRemoveFromBankDesc": "The X in the open suggestion list, or the red X in personal progress, drops the name from suggestions and from the table. Saved workouts stay untouched.",
  "instructionReassignExerciseTitle": "Reassign in a record",
  "instructionReassignExerciseDesc": "In a saved workout you can point a block at a different movement. The sets stay as they were, but they move into the new name's stats — only this session changes.",
  "instructionSectionMuscleGroups": "Muscle groups",
  "instructionMuscleGroupsIntro": "A group is an optional tag on your name. The quick workout uses it to build a balanced full-body session, and muscle load counts weekly sets and tonnage from it. Ten groups: chest, back, shoulders, core, front thigh, rear thigh, glutes, calves, biceps, triceps.",
  "instructionMuscleGroupTagTitle": "How to tag",
  "instructionMuscleGroupTagDesc": "The first time you enter a new name, the app asks for a group. You can answer Later, or Not for quick workout if the movement should stay out of the mix. The chip under the name in personal progress and favorites is easy to change or clear.",
  "instructionSectionFavorites": "Favorites",
  "instructionFavoriteStarTitle": "Star",
  "instructionFavoriteStarDesc": "The star is on the exercise card in a session and in the personal progress table. Favorites stay at the top of the list.",
  "instructionBuildFromFavoritesTitle": "Build workout",
  "instructionBuildFromFavoritesDesc": "On the favorites screen, tick the movements you want — the button appears at once. The session opens in that order, with grey hints from last time. For a client, the same action opens their workout.",
  "instructionSectionQuickWorkout": "Quick workout",
  "instructionQuickWorkoutHowTitle": "Four slots",
  "instructionQuickWorkoutHowDesc": "Chest, back, one half of the legs (front or rear thigh — never both on the same day), and one movement for shoulders, arms, or core. In each slot the app picks the group that has gone longest without work, and prefers a favorite.",
  "instructionQuickWorkoutPreviewTitle": "Preview and swap",
  "instructionQuickWorkoutPreviewDesc": "You see the full line-up before you start: any slot can be swapped for another exercise from the same group. If there are not enough tagged movements, the app says so and opens personal progress so you can add tags.",
  "instructionPersonalProgressIntro": "One table of every movement from saved workouts. Favorites on top, the rest alphabetically; search finds a name. Open it from the training menu or from a client profile.",
  "instructionProgressBestSetTitle": "Best set",
  "instructionProgressBestSetDesc": "The set with the highest estimated 1RM across your history. For movements without weight, it is the set with the most reps.",
  "instructionProgressMaxVolumeTitle": "Max volume",
  "instructionProgressMaxVolumeDesc": "The largest tonnage for this exercise in a single workout — a useful anchor when you plan working volume.",
  "instructionSectionProgressChart": "Exercise chart",
  "instructionProgressChartIntro": "Three independent curves by date. Left axis is weight, right axis is reps; the yellow line is normalized so the trends can be compared by shape. Switch the window — month, year, all time — and tap a point for that day's numbers. Cardio does not appear on the chart.",
  "instructionProgressLineWeightDesc": "Red — heaviest weight in one set that day.",
  "instructionProgressLineRepsDesc": "Cyan — most reps in a set, not necessarily with the heaviest weight.",
  "instructionProgressLineVolumeDesc": "Yellow — daily tonnage: the sum of weight × reps for sets where both fields are filled.",
  "instructionProgressChartSessionHighlight": "In a live workout the chart button lights up when you beat a record: red for set weight, yellow for exercise tonnage, cyan for total reps on movements without weight. If more than one applies, red wins, then yellow, then cyan. Saved history has no highlight.",
  "instructionRhythmIntro": "Once you have at least three strength days in the last four weeks, a rhythm gauge appears at the top of the training screen, beside the muscle-load figure. It is not a goal and not a grade — just how often you currently get to the gym. The figure stays even before the gauge appears.",
  "instructionRhythmGaugeTitle": "Days per week",
  "instructionRhythmGaugeDesc": "The arc fills from one to six days — a four-week average. Days with strength work count; cardio-only days do not. The denser the rhythm, the further the color moves from steel through gold toward rust.",
  "instructionRhythmInsightTitle": "Rhythm breakdown",
  "instructionRhythmInsightDesc": "Tap the gauge: the app names your mode — an easy rhythm, a steady rhythm, a dense rhythm, or almost no days off — and explains what that means for recovery. A client's gauge opens the same breakdown.",
  "instructionRhythmDeloadTitle": "Deload week",
  "instructionRhythmDeloadDesc": "A deload is not a pause — it is a week at half power: working weights and set counts down 30–50%, or cardio only. Muscle recovers faster than ligaments, tendons, and joints — this week lets them catch up.",
  "instructionRhythmNudgeTitle": "Reminder",
  "instructionRhythmNudgeDesc": "If you hold two and a half sessions a week or more and have not deloaded in a while, the app suggests taking such a week. The denser the rhythm, the sooner the hint appears. It shows at most once a week, in personal mode only — and it stays a recommendation, not medical advice.",
  "instructionSectionMuscleLoad": "Muscle load",
  "instructionMuscleLoadIntro": "The figure beside the rhythm gauge opens the load screen. The same picture is larger, with a callout for each of the ten muscle groups. The first number is working sets per week, the second is tonnage. Both are the average of the last 28 days.",
  "instructionMuscleLoadCountsTitle": "What counts",
  "instructionMuscleLoadCountsDesc": "A set counts only when RIR is set, from 0 to 5. An empty RIR and ∞ are warm-ups. Cardio does not count, nor does an exercise with no group or one marked not for the quick workout. Tonnage is weight times reps, in the units you log.",
  "instructionMuscleLoadTrendTitle": "Week by week",
  "instructionMuscleLoadTrendDesc": "Tap a callout to open that group's chart. Each mark is a calendar week with at least one set that has RIR. Weeks without those sets stay off the chart. Month, year, and all time change the window. The number on the callout is the 28-day average; a mark is that week's actual total.",
  "instructionMuscleLoadLineSetsDesc": "Cyan — working sets that week.",
  "instructionMuscleLoadLineTonnageDesc": "Yellow — tonnage that week, weight times reps.",
  "instructionSectionCalendar": "Calendar and history",
  "instructionCalendarBrowseTitle": "How to browse",
  "instructionCalendarBrowseDesc": "Swipe to change months; tap the month name for a quick date picker. A dot under a day means there was a workout.",
  "instructionCalendarAddTitle": "Backdated entry",
  "instructionCalendarAddDesc": "Pick a day, set a time, and add a workout — including a date already past. Handy if you forgot to log the session.",
  "instructionNavHistoryTitle": "Workout tonnage",
  "instructionNavHistoryDesc": "Every saved session shows total tonnage. Volume is one of the most reliable hypertrophy landmarks: what matters is not a single-day record, but how it holds from week to week.",
  "instructionHistoryEditTitle": "Editing records",
  "instructionHistoryEditDesc": "Open a saved workout and edit it in place: add an exercise you skipped, a set, or a note, change the numbers or the order, or delete the session. Changes save immediately.",
  "instructionSectionStats": "Statistics",
  "instructionStatsTitle": "Workout summary",
  "instructionStatsDesc": "The chart icon in the header of the training or coach screen: how many sessions this month, this year, and all time. In coach mode it also breaks the count down per client.",
  "instructionSectionBackup": "Backup",
  "instructionNavImportExportTitle": "Export and import",
  "instructionNavImportExportDesc": "Export packs history, the exercise list, favorites, group tags, clients, and the schedule into one JSON file. Import merges the file into current data and skips duplicates — nothing is wiped. A coach backup is separate from a personal one.",
  "instructionBackupNudgeTitle": "Backup reminder",
  "instructionBackupNudgeDesc": "Data lives on this device only: no accounts, no cloud. Every four weeks the app offers to save a copy — if the phone is lost, history comes back only from that file.",
  "instructionTrainerIntro": "I train others is a separate space for working with people: clients, a schedule, and a history per person. Personal workouts and coach data never cross.",
  "instructionClientsTitle": "Clients",
  "instructionClientsDesc": "A list with the goal, last session, and next session. The card holds goal, weight, height, and private coach notes. The name is set at creation and cannot be changed later.",
  "instructionClientProfileTitle": "Client profile",
  "instructionClientProfileDesc": "Today's session starts here, along with progress, favorites, and history by month. The muscle-load figure is here, and the rhythm gauge joins it once there are enough strength days. Both read this client's finished sessions. Deleting a client removes future sessions; past workouts stay for reporting.",
  "instructionTrainerScheduleTitle": "Schedule",
  "instructionTrainerScheduleDesc": "The coach calendar shows sessions for every client: a play icon means planned, a check means finished, an hourglass means today is in progress. Empty plans from past days are cleared on their own.",
  "instructionTrainerTimeTitle": "Change time",
  "instructionTrainerTimeDesc": "The pencil on a planned session moves the clock on the same day — on the calendar, or next to the date inside the session. You can also hold the session card. Exercises, the session note, and the reminder stay. A finished or imported session keeps its time.",
  "instructionTrainerPlanTitle": "Session plan",
  "instructionTrainerPlanDesc": "For a future date you can lay out exercises and a note in advance and save without finishing the workout. Last weights and reps arrive as grey hints. Only finished sessions go into history.",
  "instructionTrainerRepeatTitle": "Repeat last",
  "instructionTrainerRepeatDesc": "From the client profile, or as a switch when adding a session on the calendar. One past workout is repeated as-is. If there are more, pick from the last five: they are sorted by the note, and you can search that note. The exercise list is copied; weights and reps come as grey hints, not as finished sets.",
  "instructionPrintSessionTitle": "Print a session",
  "instructionPrintSessionDesc": "On a finished workout, the print icon in the header builds an A4 sheet with that day's line-up and numbers. Then the system sheet: printer, PDF, or send to the client.",
  "instructionImportAthleteTitle": "Import an athlete's history",
  "instructionImportAthleteDesc": "A dedicated button in coach statistics: a file from personal mode becomes a new client, including favorites and group tags. Transferred workouts are marked as imported, and exercise names stay separate from yours.",
  "printSession": "Print",
  "printSessionEmpty": "Nothing to print yet. Log at least one set.",
